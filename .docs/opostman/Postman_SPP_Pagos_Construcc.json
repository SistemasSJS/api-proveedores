			"value": "http://localhost:80/api",
			"type": "string"
		},
		{
			"key": "apiKey",
			"value": "7f2wnCyn7ctmTE7B3mrtDPKCPVF9z8pYseihsHA6",
			"type": "string"
		},
		{
			"key": "proveedorId",
			"value": "1",
