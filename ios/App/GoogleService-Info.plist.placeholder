<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 
    INSTRUCCIONES:
    1. Ve a: https://console.firebase.google.com/project/app-proveedores-notificacion
    2. Project Settings → General → Your apps
    3. Si no tienes app iOS: Add app → iOS
    4. Bundle ID: com.construcc.proveedores
    5. Descargar GoogleService-Info.plist
    6. Reemplazar este archivo con el descargado
    7. Renombrar a: GoogleService-Info.plist (sin .placeholder)
    -->
    <key>BUNDLE_ID</key>
    <string>com.construcc.proveedores</string>
    <key>PROJECT_ID</key>
    <string>app-proveedores-notificacion</string>
    <key>STORAGE_BUCKET</key>
    <string>app-proveedores-notificacion.firebasestorage.app</string>
    <key>IS_ADS_ENABLED</key>
    <false/>
    <key>IS_ANALYTICS_ENABLED</key>
    <false/>
    <key>IS_APPINVITE_ENABLED</key>
    <true/>
    <key>IS_GCM_ENABLED</key>
    <true/>
    <key>IS_SIGNIN_ENABLED</key>
    <true/>
    <key>GOOGLE_APP_ID</key>
    <string>PLACEHOLDER_IOS_APP_ID</string>
    <key>GCM_SENDER_ID</key>
    <string>989092385974</string>
</dict>
</plist>
