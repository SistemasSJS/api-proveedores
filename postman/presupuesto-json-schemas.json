{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api-proveedores.local/schemas/presupuesto",
  "title": "Presupuestos — esquemas API (api-proveedores)",
  "description": "Esquemas JSON Schema alineados con Form Requests, Resources y ApiResponse. Úsalos en Postman: pestaña Body → JSON → Schema (o importar como componentes). Base de rutas Laravel: /api",

  "definitions": {
    "ApiResponseSuccess": {
      "type": "object",
      "required": ["status", "code", "message", "data", "errors"],
      "properties": {
        "status": { "const": "SUCCESS" },
        "code": { "type": "integer", "description": "HTTP status (200, 201, …)" },
        "message": { "type": "string" },
        "data": { "description": "Payload; null en delete sin cuerpo" },
        "errors": { "type": "null" }
      }
    },
    "ApiResponseError": {
      "type": "object",
      "required": ["status", "code", "message", "data", "errors"],
      "properties": {
        "status": { "const": "ERROR" },
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": {},
        "errors": {
          "description": "string[], objeto de validación Laravel, o null",
          "oneOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "object" }, { "type": "null" }]
        }
      }
    },
    "ApiResponsePaginated": {
      "type": "object",
      "required": ["status", "code", "message", "meta", "data", "errors"],
      "properties": {
        "status": { "const": "SUCCESS" },
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "meta": {
          "type": "object",
          "properties": {
            "pagination": {
              "type": "object",
              "properties": {
                "current_page": { "type": "integer" },
                "from": { "type": ["integer", "null"] },
                "last_page": { "type": "integer" },
                "per_page": { "type": "integer" },
                "to": { "type": ["integer", "null"] },
                "total": { "type": "integer" }
              }
            },
            "segment_counts": {
              "type": "object",
              "description": "Solo en GET listado de presupuestos",
              "properties": {
                "borrador": { "type": "integer" },
                "enviados": { "type": "integer" },
                "observados": { "type": "integer" },
                "rechazados": { "type": "integer" },
                "aceptados": { "type": "integer" }
              }
            }
          }
        },
        "data": { "type": "array", "items": { "$ref": "#/definitions/PresupuestoResource" } },
        "errors": { "type": "null" }
      }
    },
    "PresupuestoConceptoInput": {
      "type": "object",
      "required": ["descripcion", "cantidad", "unidad", "precio_unitario"],
      "properties": {
        "descripcion": { "type": "string" },
        "cantidad": { "type": "number", "minimum": 0.0001 },
        "unidad": { "type": "string", "maxLength": 50 },
        "precio_unitario": { "type": "number", "minimum": 0 }
      }
    },
    "StorePresupuestoBody": {
      "type": "object",
      "required": ["proveedor_id", "fecha_emision", "concepto_general", "conceptos"],
      "properties": {
        "numero_presupuesto": { "type": ["string", "null"], "maxLength": 255 },
        "proveedor_id": { "type": "integer" },
        "empresa_receptora_id": { "type": ["integer", "null"] },
        "empresa_receptora_nombre": { "type": ["string", "null"], "maxLength": 255 },
        "empresa_receptora_puesto": { "type": ["string", "null"], "maxLength": 255 },
        "empresa_receptora_empresa": { "type": ["string", "null"], "maxLength": 255 },
        "empresa_receptora_alias": { "type": ["string", "null"], "maxLength": 255 },
        "empresa_receptora_telefono": { "type": ["string", "null"], "maxLength": 30 },
        "empresa_receptora_correo": { "type": ["string", "null"], "format": "email", "maxLength": 255 },
        "fecha_emision": { "type": "string", "format": "date" },
        "concepto_general": { "type": "string" },
        "con_iva": { "type": "boolean" },
        "iva_porcentaje": { "type": "number", "minimum": 0, "maximum": 100 },
        "term_cond_dias_vigencia": { "type": "integer", "minimum": 0 },
        "term_cond_moneda": { "type": "string", "maxLength": 10 },
        "term_cond_iva": { "type": "number", "minimum": 0, "maximum": 100 },
        "term_cond_anticipo_porcentaje": { "type": "number", "minimum": 0, "maximum": 100 },
        "term_cond_tiempo_entrega_dias": { "type": "integer", "minimum": 0 },
        "obs_garantia_dias": { "type": "integer", "minimum": 0 },
        "obs_traslados": { "type": "boolean" },
        "obs_viaticos": { "type": "boolean" },
        "estado": {
          "type": "string",
          "enum": ["borrador", "enviado", "aceptado", "rechazado", "rechazado_con_observacion", "vencido"]
        },
        "conceptos": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/PresupuestoConceptoInput" }
        }
      },
      "description": "Store y Update comparten las mismas reglas (StorePresupuestoRequest / UpdatePresupuestoRequest). Si no envías empresa_receptora_id, Laravel exige empresa_receptora_nombre y empresa_receptora_empresa."
    },
    "PresupuestoConceptoResource": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "numero": { "type": "integer" },
        "descripcion": { "type": "string" },
        "cantidad": { "type": "number" },
        "unidad": { "type": "string" },
        "precio_unitario": { "type": "number" },
        "precio_total": { "type": "number" }
      }
    },
    "PresupuestoResource": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "uuid": { "type": ["string", "null"] },
        "numero_presupuesto": { "type": "string" },
        "fecha_emision": { "type": "string", "format": "date" },
        "fecha_vencimiento": { "type": ["string", "null"], "format": "date" },
        "concepto_general": { "type": "string" },
        "subtotal": { "type": "number" },
        "con_iva": { "type": "boolean" },
        "iva_porcentaje": { "type": "number" },
        "iva_total": { "type": "number" },
        "total": { "type": "number" },
        "term_cond_dias_vigencia": { "type": ["integer", "null"] },
        "term_cond_moneda": { "type": "string" },
        "term_cond_iva": { "type": "number" },
        "term_cond_anticipo_porcentaje": { "type": ["number", "null"] },
        "term_cond_tiempo_entrega_dias": { "type": ["integer", "null"] },
        "obs_garantia_dias": { "type": "integer" },
        "obs_traslados": { "type": "boolean" },
        "obs_viaticos": { "type": "boolean" },
        "estado": { "type": "string" },
        "motivo_rechazo": { "type": ["string", "null"] },
        "item_visto": { "type": "boolean" },
        "token_publico": { "type": ["string", "null"] },
        "proveedor": {
          "type": "object",
          "properties": {
            "id": { "type": "integer" },
            "nombre": { "type": ["string", "null"] }
          }
        },
        "empresa_receptora": {
          "type": "object",
          "properties": {
            "id": { "type": ["integer", "null"] },
            "nombre": { "type": ["string", "null"] },
            "puesto": { "type": ["string", "null"] },
            "empresa": { "type": ["string", "null"] },
            "alias_empresa": { "type": ["string", "null"] },
            "telefono": { "type": ["string", "null"] },
            "correo": { "type": ["string", "null"] },
            "origen": { "type": "string", "enum": ["cartera", "captura"] }
          }
        },
        "user": {
          "type": "object",
          "properties": {
            "id": { "type": "integer" },
            "name": { "type": "string" }
          }
        },
        "empresa_receptora_nombre": { "type": ["string", "null"] },
        "empresa_receptora_puesto": { "type": ["string", "null"] },
        "empresa_receptora_empresa": { "type": ["string", "null"] },
        "empresa_receptora_alias": { "type": ["string", "null"] },
        "empresa_receptora_telefono": { "type": ["string", "null"] },
        "empresa_receptora_correo": { "type": ["string", "null"] },
        "conceptos": {
          "type": "array",
          "items": { "$ref": "#/definitions/PresupuestoConceptoResource" }
        },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "PresupuestoPublicResource": {
      "type": "object",
      "description": "Respuesta pública (sin token de app); incluye logo y datos fiscales básicos del proveedor",
      "properties": {
        "id": { "type": "integer" },
        "uuid": { "type": ["string", "null"] },
        "numero_presupuesto": { "type": "string" },
        "fecha_emision": { "type": "string", "format": "date" },
        "fecha_vencimiento": { "type": ["string", "null"], "format": "date" },
        "concepto_general": { "type": "string" },
        "subtotal": { "type": "number" },
        "con_iva": { "type": "boolean" },
        "iva_porcentaje": { "type": "number" },
        "iva_total": { "type": "number" },
        "total": { "type": "number" },
        "term_cond_dias_vigencia": { "type": ["integer", "null"] },
        "term_cond_moneda": { "type": "string" },
        "term_cond_iva": { "type": "number" },
        "term_cond_anticipo_porcentaje": { "type": ["number", "null"] },
        "term_cond_tiempo_entrega_dias": { "type": ["integer", "null"] },
        "obs_garantia_dias": { "type": "integer" },
        "obs_traslados": { "type": "boolean" },
        "obs_viaticos": { "type": "boolean" },
        "motivo_rechazo": { "type": ["string", "null"] },
        "estado": { "type": "string" },
        "proveedor": {
          "type": "object",
          "properties": {
            "id": { "type": "integer" },
            "nombre": { "type": ["string", "null"] },
            "logo": { "type": ["string", "null"] },
            "rfc": { "type": ["string", "null"] },
            "direccion_empresa": { "type": ["string", "null"] },
            "ciudad": { "type": ["string", "null"] },
            "estado": { "type": ["string", "null"] },
            "telefono": { "type": ["string", "null"] },
            "email": { "type": ["string", "null"] }
          }
        },
        "empresa_receptora": {
          "type": "object",
          "properties": {
            "nombre": { "type": ["string", "null"] },
            "puesto": { "type": ["string", "null"] },
            "empresa": { "type": ["string", "null"] },
            "telefono": { "type": ["string", "null"] },
            "correo": { "type": ["string", "null"] }
          }
        },
        "conceptos": {
          "type": "array",
          "items": { "$ref": "#/definitions/PresupuestoConceptoResource" }
        }
      }
    },
    "NextFolioData": {
      "type": "object",
      "properties": {
        "folio": { "type": "string", "description": "Ej. PRES-0001" },
        "proveedor_id": { "type": "integer" }
      }
    },
    "RechazarPresupuestoPublicoBody": {
      "type": "object",
      "properties": {
        "motivo": { "type": "string", "maxLength": 1000 }
      }
    },
    "StoreCarteraClienteBody": {
      "type": "object",
      "required": ["nombre", "empresa"],
      "properties": {
        "nombre": { "type": "string", "maxLength": 255 },
        "puesto": { "type": ["string", "null"], "maxLength": 255 },
        "empresa": { "type": "string", "maxLength": 255 },
        "alias_empresa": { "type": ["string", "null"], "maxLength": 255 },
        "telefono": { "type": ["string", "null"], "maxLength": 30 },
        "correo": { "type": ["string", "null"], "format": "email", "maxLength": 255 }
      }
    },
    "PresupuestoIndexQuery": {
      "type": "object",
      "description": "Query string GET .../presupuestos",
      "properties": {
        "search": { "type": "string" },
        "uuid": { "type": "string" },
        "numero_presupuesto": { "type": "string" },
        "empresa_receptora_id": { "type": "integer" },
        "user_id": { "type": "integer" },
        "fecha_emision": { "type": "string" },
        "fecha_desde": { "type": "string", "format": "date" },
        "fecha_hasta": { "type": "string", "format": "date" },
        "fecha_vencimiento_desde": { "type": "string", "format": "date" },
        "fecha_vencimiento_hasta": { "type": "string", "format": "date" },
        "con_iva": { "type": "boolean" },
        "total": { "type": "number" },
        "estado": { "type": "string" },
        "item_visto": { "type": "boolean" },
        "segmento": { "type": "string", "enum": ["observados", "rechazados"], "description": "Si se usa, el controlador omite filtro estado" },
        "sort_by": { "type": "string", "default": "created_at" },
        "order": { "type": "string", "enum": ["asc", "desc"], "default": "desc" },
        "page": { "type": "integer" },
        "per_page": { "type": "integer" }
      }
    }
  }
}
