							"raw": "{\n  \"usuario_id\": 1,\n  \"nivel_id\": 2,\n  \"razon_social\": \"Empresa Demo Actualizada S.A. de C.V.\",\n  \"nombre_comercial\": \"Empresa Demo Actualizada\",\n  \"email\": \"nuevo@empresademo.com\",\n  \"telefono\": \"5598765432\",\n  \"celular\": \"5598765433\",\n  \"cuentas_bancarias\": [\n    {\n      \"id\": 1,\n      \"alias\": \"Cuenta principal actualizada\",\n      \"banco_clave\": \"012\",\n      \"banco_nombre\": \"Banamex\",\n      \"titular_cuenta\": \"Empresa Demo\",\n      \"preferida\": true\n    }\n  ]\n}"
