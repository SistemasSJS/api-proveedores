    "ConstruccCuentaBancariaStoreJson": {
      "type": "object",
      "required": ["alias", "banco_clave", "banco_nombre", "tipo_cuenta", "campo_dependiente", "titular_cuenta"],
      "properties": {
        "alias": { "type": "string", "maxLength": 255 },
        "banco_clave": { "type": "string", "maxLength": 10 },
        "banco_nombre": { "type": "string", "maxLength": 255 },
        "tipo_cuenta": { "type": "string", "maxLength": 255 },
        "campo_dependiente": { "type": "string", "maxLength": 255 },
        "titular_cuenta": { "type": "string", "maxLength": 255 },
        "referencia": { "type": ["string", "null"], "maxLength": 255 },
        "sucursal": { "type": ["string", "null"], "maxLength": 255 },
        "swift": { "type": ["string", "null"], "maxLength": 255 }
      }
    },

    "SolicitudPagoAutorizarJson": {
      "type": "object",
      "required": ["rol"],
      "properties": {
        "rol": { "type": "string", "enum": ["DG", "DT", "PC", "SI"] }
      }
    },
    "SolicitudPagoAutorizarParcialJson": {
      "type": "object",
      "required": ["rol", "monto_autorizado", "notas_autorizacion", "usuario_id", "usuario_nombre"],
      "properties": {
        "rol": { "type": "string", "enum": ["DG", "DT", "PC", "SI"] },
        "monto_autorizado": { "type": "number", "exclusiveMinimum": 0 },
        "notas_autorizacion": { "type": "string", "minLength": 10 },
        "usuario_id": { "type": "integer" },
        "usuario_nombre": { "type": "string", "maxLength": 255 }
      }
    },
    "SolicitudPagoRechazarJson": {
      "type": "object",
      "required": ["rol", "motivo_rechazo"],
      "properties": {
        "rol": { "type": "string", "enum": ["DG", "DT", "PC", "SI", "DA"] },
        "motivo_rechazo": { "type": "string", "maxLength": 500 }
      }
    },
    "SolicitudPagoConfirmarPagoMultipart": {
      "type": "object",
      "description": "POST `{solicitudPago}/confirmar-pago`. multipart: rol, monto_pagado, comprobante (file), observaciones, cuenta_bancaria_empresa_construcc_id, fecha_hora_pago, nombre_beneficiario, clave_rastreo, banco",
      "required": ["rol", "monto_pagado", "fecha_hora_pago", "nombre_beneficiario", "clave_rastreo", "banco"],
      "properties": {
        "rol": { "const": "DA" },
        "monto_pagado": { "type": "number", "minimum": 0.01 },
        "comprobante": { "description": "archivo pdf, jpg, jpeg, png; max 5MB" },
        "observaciones": { "type": ["string", "null"], "maxLength": 500 },
        "cuenta_bancaria_empresa_construcc_id": { "type": ["number", "null"] },
        "fecha_hora_pago": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$" },
        "nombre_beneficiario": { "type": "string", "maxLength": 255 },
        "clave_rastreo": { "type": "string", "maxLength": 50 },
        "banco": { "type": "string", "maxLength": 50 }
      }
    },
    "SolicitudPagoActualizarComprobanteMultipart": {
      "type": "object",
      "description": "POST `{solicitudPago}/actualizar-comprobante-pago`",
      "required": ["rol", "fecha_hora_pago", "nombre_beneficiario", "clave_rastreo", "banco"],
      "properties": {
        "rol": { "const": "DA" },
        "comprobante": { "description": "archivo requerido" },
        "observaciones": { "type": ["string", "null"], "maxLength": 500 },
        "fecha_hora_pago": { "type": "string" },
        "nombre_beneficiario": { "type": "string", "maxLength": 255 },
        "clave_rastreo": { "type": "string", "maxLength": 50 },
        "banco": { "type": "string", "maxLength": 50 }
      }
    },
    "MarcarVerificadaJson": {
      "type": "object",
      "required": ["usuario_id", "nivel_id", "empresa_id"],
      "properties": {
        "usuario_id": { "type": "integer" },
        "nivel_id": { "type": "integer" },
        "empresa_id": {},
        "obra_id": { "type": ["integer", "null"] },
        "tipo": { "type": ["string", "null"] },
        "tipo_id": { "type": ["integer", "null"] },
        "notas": { "type": ["string", "null"] },
        "utilizara": { "type": ["string", "null"] },
        "equipo": { "type": ["string", "null"] },
        "equipo_id": { "type": ["integer", "null"] }
