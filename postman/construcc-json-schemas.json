{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api-proveedores.local/schemas/construcc",
  "title": "Módulo Construcc — esquemas API (routes/segmented/construcc.php)",
  "description": "Base URL Laravel: `/api/construcc`. Autenticación: header `X-API-KEY` (valor `config('api-access.registration_key')`). Si la clave falla, la API responde 401 con `{ \"error\", \"message\" }` (no es el formato ApiResponse estándar). El resto de éxitos/errores JSON suelen seguir `status` (SUCCESS|ERROR), `code`, `message`, `data` o `meta`+`data`, `errors` (trait ApiResponse). Los endpoints `multipart/form-data` no se pueden representar solo con JSON Schema: usar descripción y pruebas en Postman con Body form-data.",

  "definitions": {
    "ApiKeyUnauthorized": {
      "type": "object",
      "description": "Respuesta 401 del middleware CheckApiKey",
      "properties": {
        "error": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "ApiResponseSuccess": {
      "type": "object",
      "required": ["status", "code", "message", "data", "errors"],
      "properties": {
        "status": { "const": "SUCCESS" },
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": {},
        "errors": { "type": "null" }
      }
    },
    "ApiResponseError": {
      "type": "object",
      "properties": {
        "status": { "const": "ERROR" },
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": {},
        "errors": {}
      }
    },
    "ApiResponsePaginated": {
      "type": "object",
      "properties": {
        "status": { "const": "SUCCESS" },
        "meta": {
          "type": "object",
          "properties": {
            "pagination": { "type": "object" },
            "conteo": { "type": "object" },
            "periodo": { "type": "string" },
            "segment_counts": { "type": "object" }
          }
        },
        "data": { "type": "array" }
      }
    },

    "GenerarSolicitudPagoConstruccMultipart": {
      "type": "object",
      "description": "POST `solicitudes-pago/generar-spp-construcc`. Multipart. Validación: GenerarSolicitudPagoConstruccRequest. Regla extra: al menos uno entre cuenta_bancaria_cuenta, cuenta_bancaria_clabe, cuenta_bancaria_tarjeta.",
      "properties": {
        "descripcion_concepto": { "type": "string", "minLength": 1, "maxLength": 500 },
        "monto_total": { "type": "number", "minimum": 0 },
        "observaciones": { "type": ["string", "null"], "maxLength": 1000 },
        "factura_pdf": { "description": "file pdf, max 10MB" },
        "factura_xml": { "description": "file xml, max 5MB" },
        "cotizacion": { "description": "opcional; si se omite factura obligatoria" },
        "proveedor_rfc": { "type": "string", "minLength": 12, "maxLength": 13 },
        "proveedor_razon_social": { "type": "string", "maxLength": 255 },
        "proveedor_nombre_comercial": { "type": "string", "maxLength": 255 },
        "proveedor_email": { "type": "string", "format": "email" },
        "proveedor_telefono": { "type": "string", "maxLength": 20 },
        "proveedor_celular": { "type": ["string", "null"], "maxLength": 20 },
        "cuenta_bancaria_alias": { "type": "string", "maxLength": 255 },
        "cuenta_bancaria_banco_clave": { "type": "string", "maxLength": 10 },
        "cuenta_bancaria_banco_nombre": { "type": "string", "maxLength": 255 },
        "cuenta_bancaria_cuenta": { "description": "10-12 dígitos si aplica" },
        "cuenta_bancaria_clabe": { "description": "18 dígitos opcional" },
        "cuenta_bancaria_tarjeta": { "description": "16 dígitos opcional" },
        "cuenta_bancaria_titular_cuenta": { "type": "string", "maxLength": 255 },
        "cuenta_bancaria_referencia": { "type": ["string", "null"], "maxLength": 255 },
        "cuenta_bancaria_sucursal": { "type": ["string", "null"], "maxLength": 255 },
        "cuenta_bancaria_swift": { "type": ["string", "null"], "maxLength": 255 },
        "empresa_construcc_id": { "type": ["integer", "null"] },
        "empresa": { "type": ["string", "null"], "maxLength": 255 },
        "usuario_id": { "type": ["integer", "null"] },
        "usuario_nombre": { "type": ["string", "null"], "maxLength": 255 },
        "nivel_id": { "type": ["integer", "null"], "minimum": 0, "maximum": 6 },
        "obra_id": { "type": ["integer", "null"] },
        "tipo": { "type": ["string", "null"], "maxLength": 255 },
        "tipo_id": { "type": ["integer", "null"] },
        "notas": { "type": ["string", "null"], "maxLength": 1000 },
        "utilizara": { "type": ["string", "null"], "maxLength": 255 },
        "equipo": { "type": ["string", "null"], "maxLength": 255 },
        "equipo_id": { "type": ["integer", "null"] }
      }
    },

    "GenerarSppProveedorMultipart": {
      "type": "object",
      "description": "POST `proveedor/{proveedor}/solicitudes-pago`. ConstruccProveedorGenerarSppRequest: si no hay archivo cotización, factura_pdf y factura_xml obligatorios.",
      "properties": {
        "descripcion_concepto": { "type": "string" },
        "monto_total": { "type": "number", "minimum": 0 },
        "observaciones": { "type": ["string", "null"] },
        "cotizacion": {},
        "factura_pdf": {},
        "factura_xml": {},
        "cuenta_bancaria_id": { "type": "integer" },
        "empresa_construcc_id": { "type": "integer" },
        "usuario_id": { "type": "integer" },
        "usuario_nombre": { "type": "string" },
        "nivel_id": { "type": "integer", "enum": [0, 1, 2, 3, 4, 5, 6] },
        "obra_id": { "type": ["integer", "null"] },
        "tipo": { "type": ["string", "null"] },
        "tipo_id": { "type": ["integer", "null"] },
        "notas": { "type": ["string", "null"] },
        "utilizara": { "type": ["string", "null"] },
        "equipo": { "type": ["string", "null"] },
        "equipo_id": { "type": ["integer", "null"] }
      }
    },

    "ConstruccProveedorStoreJson": {
      "type": "object",
      "required": ["razon_social", "empresa_construcc_id", "usuario_id", "usuario_nombre"],
      "properties": {
        "razon_social": { "type": "string", "maxLength": 255 },
        "rfc": { "type": ["string", "null"], "minLength": 12, "maxLength": 13 },
        "email": { "type": ["string", "null"], "format": "email", "maxLength": 255 },
        "telefono": { "type": ["string", "null"], "maxLength": 20 },
        "celular": { "type": ["string", "null"], "maxLength": 20 },
        "nombre_comercial": { "type": ["string", "null"], "maxLength": 255 },
        "empresa_construcc_id": { "type": "integer" },
        "usuario_id": { "type": "integer" },
        "usuario_nombre": { "type": "string", "maxLength": 255 },
        "nivel_id": { "type": ["integer", "null"], "enum": [0, 1, 2, 3, 4, 5, 6] },
        "cuenta": {
          "type": ["object", "null"],
          "properties": {
            "alias": { "type": "string" },
            "banco_clave": { "type": "string" },
            "banco_nombre": { "type": "string" },
            "tipo_cuenta": { "type": "string" },
            "campo_dependiente": { "type": "string" },
            "titular_cuenta": { "type": "string" },
            "referencia": { "type": ["string", "null"] },
            "sucursal": { "type": ["string", "null"] },
            "swift": { "type": ["string", "null"] }
          }
        }
      }
    },

    "ConstruccProveedorUpdateJson": {
      "type": "object",
      "required": ["usuario_id", "nivel_id"],
      "properties": {
        "razon_social": { "type": "string" },
        "rfc": { "type": "string" },
        "nombre_comercial": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "telefono": { "type": "string" },
        "celular": { "type": ["string", "null"] },
        "usuario_id": { "type": "integer" },
        "nivel_id": { "type": "integer", "minimum": 0, "maximum": 6 },
        "cuentas_bancarias": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "alias": { "type": "string" },
              "banco_clave": { "type": "string" },
              "banco_nombre": { "type": "string" },
              "tipo_cuenta": { "type": "string" },
              "campo_dependiente": { "type": "string" },
              "titular_cuenta": { "type": "string" },
              "referencia": { "type": ["string", "null"] },
              "sucursal": { "type": ["string", "null"] },
              "swift": { "type": ["string", "null"] },
              "preferida": { "type": "boolean" }
            }
          }
        }
      }
