    "ConstruccPagosRegistrarPagoMultipart": {
      "type": "object",
      "description": "POST `pagos-spp/proveedor/{proveedor}/pagos` — ConstruccPagosSPPRegistrarPagoRequest",
      "required": ["comprobante_pago", "cuenta_destino_id", "monto_total", "empresa_id", "proveedor_id", "usuario_id", "usuario_nombre", "nivel_usuario", "solicitudes", "fecha_pago"],
      "properties": {
        "comprobante_pago": { "description": "file pdf,jpg,jpeg,png max 10MB" },
        "cuenta_bancaria_empresa_construcc_id": { "type": ["number", "null"] },
        "cuenta_destino_id": { "type": "integer" },
        "monto_total": { "type": "number", "minimum": 0.01 },
        "empresa_id": { "type": "integer" },
        "proveedor_id": { "type": "integer" },
        "usuario_id": { "type": "integer" },
        "usuario_nombre": { "type": "string", "maxLength": 255 },
        "nivel_usuario": { "type": "integer", "description": "solo valores permitidos en Rule::in del request (DA=3, etc.)" },
        "fecha_pago": { "type": "string", "format": "date" },
        "info_comprobante": {
          "type": "object",
          "properties": {
            "monto": { "type": "number" },
            "fecha": { "type": "string", "format": "date" },
            "hora": { "type": "string" },
            "referencia": { "type": "string", "maxLength": 50 },
            "bancoDestino": { "type": "string" },
            "nombreBeneficiario": { "type": "string" },
            "claveRastreo": { "type": "string" }
          }
        },
        "solicitudes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["solicitud_id", "monto_pago"],
            "properties": {
              "solicitud_id": { "type": "integer" },
              "monto_pago": { "type": "number", "minimum": 0.01 },
              "uso": { "type": ["string", "null"] },
              "mp": { "type": ["string", "null"] },
              "fp": { "type": ["string", "null"] },
              "rf": { "type": ["string", "null"] },
              "razon_social_id": { "type": ["number", "null"] },
              "datos_facturacion_id": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
