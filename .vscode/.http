@hostname = 127.0.0.1
@port = 8080
@host = {{hostname}}:{{port}}
@contentType = application/json
@createdAt = {{$datetime iso8601}}
@modifiedBy = {{$processEnv USERNAME}}
@token = 

###

POST http://127.0.0.1:8080/api/register HTTP/1.1
Content-Type: application/json

{
    "razon_social": "Comercial XYZ",
    "nombre_comercial": "XYZ",
    "email": "proveedor@xyz.com",
    "password": "password123"
}

###

POST http://127.0.0.1:8080/api/login HTTP/1.1
Content-Type: application/json

{
    "email": "proveedor@xyz.com",
    "password": "password123"
}

###

PUT http://127.0.0.1:8080/api/proveedores/1 HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "razon_social": "Comercial XYZ Updated",
    "nombre_comercial": "XYZ Updated"
}

###

POST http://127.0.0.1:8080/api/proveedores/1/sucursales HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Sucursal Principal",
    "direccion": "Calle 123",
    "telefono": "555-1234"
}

###

GET http://127.0.0.1:8080/api/proveedores/1/sucursales HTTP/1.1
Authorization: Bearer {{token}}

###

PUT http://127.0.0.1:8080/api/proveedores/1/sucursales/1 HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Sucursal Secundaria",
    "direccion": "Avenida 456"
}

###

DELETE http://127.0.0.1:8080/api/proveedores/1/sucursales/1 HTTP/1.1
Authorization: Bearer {{token}}

###

GET http://127.0.0.1:8080/api/productos HTTP/1.1

###

POST http://127.0.0.1:8080/api/productos HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Producto A",
    "descripcion": "Descripción del producto A",
    "precio": 100.0,
    "proveedor_id": 1
}

###

PUT http://127.0.0.1:8080/api/productos/1 HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Producto A Actualizado",
    "descripcion": "Descripción actualizada del producto A",
    "precio": 120.0
}

###

DELETE http://127.0.0.1:8080/api/productos/1 HTTP/1.1
Authorization: Bearer {{token}}

