###
# ARCHIVO DE PRUEBAS HTTP - CONSTRUCC
# API Solicitudes de Pago - Endpoints actualizados según controlador
###

@baseUrl = http://localhost:8080/api/construcc/solicitudes-pago
@contentType = application/json
@acceptType = application/json
@apiKey = /%-!?=T35sT._22<1|:

### VARIABLES
@solicitudId = 5
@rol = DA


###
# 1. Listado general de solicitudes de pago
GET {{baseUrl}}
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

###
# 2. Ver detalle de solicitud específica

GET {{baseUrl}}/{{solicitudId}}
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

# DESCARGAS DE ARCHIVOS

###
# 3. Descargar comprobante de pago
GET {{baseUrl}}/{{solicitudId}}/comprobante/download
X-API-KEY: {{apiKey}}

###
# 4. Descargar factura PDF
GET {{baseUrl}}/{{solicitudId}}/factura-pdf/download
X-API-KEY: {{apiKey}}

###
###
# 5. Descargar factura XML
GET {{baseUrl}}/{{solicitudId}}/factura-xml/download
X-API-KEY: {{apiKey}}

###
# 6. Descargar cotización
GET {{baseUrl}}/{{solicitudId}}/cotizacion/download
X-API-KEY: {{apiKey}}

# CAMBIOS DE ESTATUS

###
# 7. Autorizar solicitud de pago (rol: DG, DT, CO, SI)
POST {{baseUrl}}/{{solicitudId}}/autorizar
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}

{
  "rol": "{{rol}}"
}

###
# 8. Rechazar solicitud de pago
POST {{baseUrl}}/{{solicitudId}}/rechazar
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}

{
  "rol": "DT",
  "motivo_rechazo": "El monto no coincide con la cotización original."
}

###
# 9. Confirmar pago (solo DA)
POST {{baseUrl}}/{{solicitudId}}/confirmar-pago
X-API-KEY: {{apiKey}}
Content-Type: multipart/form-data
comprobante: @./tests/files/comprobante.pdf
monto_abono: 50000.00
notas_abono: Pago parcial correspondiente a avance de obra del 50%.

# LISTADOS POR ROL Y ESTADO

###
# 10. Listar solicitudes pendientes por rol (DG, DT, CO, SI, DA)
GET {{baseUrl}}/por-rol?rol=DT
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

###
# 11. Listar solicitudes por estado (PENDIENTE, AUTORIZADA, RECHAZADA, PAGADO)
GET {{baseUrl}}/por-estado?estado=AUTORIZADA
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

# DASHBOARD Y AUXILIARES

###
# 12. Estadísticas por rol
GET {{baseUrl}}/estadisticas-rol?rol=DA
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

###
# 13. Buscar empresas constructoras
GET {{baseUrl}}/empresas-constructoras/search?search=construcciones&limit=10
X-API-KEY: {{apiKey}}

###
# 14. Estadísticas generales
GET {{baseUrl}}/estadisticas
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}
