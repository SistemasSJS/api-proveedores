
###
# CONFIGURACIÓN GLOBAL PARA PRUEBAS API
 Variables y configuración común para todos los endpoints
##
# @baseUrl = http://localhost:8080/api
@baseUrl = https://apicons.ddns.net:8092/api
@contentType = application/json
@acceptType = application/json


### Variables de autenticación (actualizar con tokens reales)
@authToken = 
@adminToken = 
@gerenteToken = 
@clienteToken = 


### Variables de IDs comunes (actualizar según tu base de datos)
@userId = 1
@proveedorId = 1
@productoId = 1
@pedidoId = 1
@categoriaId = 1
@marcaId = 1
@sucursalId = 1


### Headers comunes
@commonHeaders = Content-Type: {{contentType}}
Accept: {{acceptType}}

### Login - Obtener token de acceso
# @name login
POST {{baseUrl}}/auth/login
{{commonHeaders}}

{
  "email": "proveedor@elgrangero.com",
  "password": "Pass123!"
}

### Login - Obtener token de acceso
# @name login
POST {{baseUrl}}/auth/login
{{commonHeaders}}

{
  "email": "constucc@constucc.com.mx",
  "password": "123456"
}


### Extraer token del response del login
@authToken = {{login.response.body.data.token}}


### Obtener información del usuario autenticado
GET {{baseUrl}}/auth/me
{{commonHeaders}}
Authorization: Bearer {{authToken}}


### Refresh token
POST {{baseUrl}}/auth/refresh
{{commonHeaders}}
Authorization: Bearer {{authToken}}


### Logout
POST {{baseUrl}}/auth/logout
{{commonHeaders}}
Authorization: Bearer {{authToken}}


###
# REGISTRO DE USUARIOS (si está habilitado)
###
POST {{baseUrl}}/auth/register
{{commonHeaders}}

{
  "name": "Usuario de Prueba",
  "email": "prueba@test.com",
  "password": "password123",
  "password_confirmation": "password123",
  "role_id": 3
}


###
# RECUPERACIÓN DE CONTRASEÑA
###
POST {{baseUrl}}/auth/password/email
{{commonHeaders}}

{
  "email": "usuario@test.com"
}


### Reset contraseña con token
POST {{baseUrl}}/auth/password/reset
{{commonHeaders}}

{
  "token": "reset-token-here",
  "email": "usuario@test.com",
  "password": "nueva_password",
  "password_confirmation": "nueva_password"
}


###############################################################################
# REGISTRO BÁSICO DE PROVEEDOR CON TELÉFONO
###############################################################################

### Variables para registro
@tokenInvitacion = test_token_123
@telefonoProveedor = 6681234567

### 🆕 Registro básico de proveedor con teléfono
POST {{baseUrl}}/auth/register-proveedor-basico-sp
{{commonHeaders}}

{
  "nombre_comercial": "Mi Empresa de Prueba",
  "telefono": "{{telefonoProveedor}}",
  "password": "Pass123!",
  "password_confirmation": "Pass123!",
  "token": "{{tokenInvitacion}}",
  "empresa_construcc_id": 1,
  "empresa_construcc_nombre": "Empresa Construcción",
  "usuario_construcc_id": 1,
  "usuario_construcc_nombre": "Usuario Construcción"
}

### 🆕 Login con teléfono como usuario
POST {{baseUrl}}/auth/login
{{commonHeaders}}

{
  "email": "{{telefonoProveedor}}",
  "password": "Pass123!"
}

### 🆕 Login con teléfono (caso 2)
POST {{baseUrl}}/auth/login
{{commonHeaders}}

{
  "email": "6681234567",
  "password": "Pass123!"
}

### Verificar que el usuario se creó correctamente
GET {{baseUrl}}/auth/me
{{commonHeaders}}
Authorization: Bearer {{authToken}}


###############################################################################
# FLUJO COMPLETO DE REGISTRO
###############################################################################

### Paso 1: Registrar proveedor con teléfono
# @name registroProveedor
POST {{baseUrl}}/auth/register-proveedor-basico-sp
{{commonHeaders}}

{
  "nombre_comercial": "Proveedor Test {{$randomInt}}",
  "telefono": "668{{$randomInt}}",
  "password": "Pass123!",
  "password_confirmation": "Pass123!",
  "token": "test_token_{{$randomInt}}",
  "empresa_construcc_id": 1,
  "usuario_construcc_id": 1,
  "usuario_construcc_nombre": "Usuario Test"
}

### Paso 2: Login con el teléfono registrado
POST {{baseUrl}}/auth/login
{{commonHeaders}}

{
  "email": "668{{$randomInt}}",
  "password": "Pass123!"
}

### Paso 3: Verificar información del usuario
GET {{baseUrl}}/auth/me
{{commonHeaders}}
Authorization: Bearer {{authToken}}


###############################################################################
# CASOS DE ERROR - REGISTRO CON TELÉFONO
###############################################################################

### ❌ Intento de registro con teléfono duplicado
POST {{baseUrl}}/auth/register-proveedor-basico-sp
{{commonHeaders}}

{
  "nombre_comercial": "Otro Proveedor",
  "telefono": "6681234567",  // Teléfono ya existente
  "password": "Pass123!",
  "password_confirmation": "Pass123!",
  "token": "test_token_456",
  "empresa_construcc_id": 1
}
# Respuesta esperada: 422 - "Este teléfono ya está registrado en el sistema"

### ❌ Teléfono con formato inválido (muy corto)
POST {{baseUrl}}/auth/register-proveedor-basico-sp
{{commonHeaders}}

{
  "nombre_comercial": "Proveedor Test",
  "telefono": "12345",  // Menos de 10 dígitos
  "password": "Pass123!",
  "password_confirmation": "Pass123!",
  "token": "test_token_789"
}
# Respuesta esperada: 422 - "El teléfono debe tener 10 dígitos"

### ❌ Contraseñas no coinciden
POST {{baseUrl}}/auth/register-proveedor-basico-sp
{{commonHeaders}}

{
  "nombre_comercial": "Proveedor Test",
  "telefono": "6689999999",
  "password": "Pass123!",
  "password_confirmation": "Pass456!",  // No coincide
  "token": "test_token_012"
}
# Respuesta esperada: 422 - "Las contraseñas no coinciden"


###############################################################################
# VALIDACIONES PREVIAS AL REGISTRO
###############################################################################

### ✅ Verificar si un teléfono está disponible
POST {{baseUrl}}/auth/verificar-telefono
{{commonHeaders}}

{
  "telefono": "6681234567"
}
# Respuesta: {"existe": true/false, "telefono": "6681234567"}

### ✅ Verificar teléfono disponible (nuevo)
POST {{baseUrl}}/auth/verificar-telefono
{{commonHeaders}}

{
  "telefono": "6689999999"
}
# Respuesta esperada: {"existe": false, "telefono": "6689999999"}

### ✅ Verificar email disponible
POST {{baseUrl}}/auth/verificar-email
{{commonHeaders}}

{
  "email": "test@example.com"
}

### ✅ Verificar razón social disponible
POST {{baseUrl}}/auth/verificar-razon-social
{{commonHeaders}}

{
  "razon_social": "Mi Empresa SA de CV"
}

### Error: Teléfono inválido (menos de 10 dígitos)
POST {{baseUrl}}/auth/register-proveedor-basico-sp
{{commonHeaders}}

{
  "nombre_comercial": "Test Error",
  "telefono": "12345",
  "password": "Pass123!",
  "password_confirmation": "Pass123!",
  "token": "test_token"
}

### Error: Teléfono inválido (más de 10 dígitos)
POST {{baseUrl}}/auth/register-proveedor-basico-sp
{{commonHeaders}}

{
  "nombre_comercial": "Test Error",
  "telefono": "12345678901",
  "password": "Pass123!",
  "password_confirmation": "Pass123!",
  "token": "test_token"
}

### Error: Contraseñas no coinciden
POST {{baseUrl}}/auth/register-proveedor-basico-sp
{{commonHeaders}}

{
  "nombre_comercial": "Test Error",
  "telefono": "6681234567",
  "password": "Pass123!",
  "password_confirmation": "DiferentePass!",
  "token": "test_token"
}

### Error: Teléfono faltante
POST {{baseUrl}}/auth/register-proveedor-basico-sp
{{commonHeaders}}

{
  "nombre_comercial": "Test Error",
  "password": "Pass123!",
  "password_confirmation": "Pass123!",
  "token": "test_token"
}
