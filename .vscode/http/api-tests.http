###############################################################################
# 🏗️ 7. MÓDULO CONSTRUCCIÓN (API TOKEN)
###############################################################################

### Buscar productos para construcción con filtros avanzados
POST {{baseUrl}}/construcc/productos/buscar
{{commonHeaders}}
X-API-TOKEN: {{construccToken}}

{
  "filtros": {
    "categoria": "construccion",
    "subcategoria": "herramientas",
    "marca": "DeWalt",
    "precio_min": 100.00,
    "precio_max": 1000.00,
    "disponible": true
  },
  "busqueda": {
    "termino": "taladro",
    "campos": ["nombre", "descripcion", "sku"]
  },
  "ordenamiento": {
    "campo": "precio_base",
    "direccion": "asc"
  },
  "paginacion": {
    "pagina": 1,
    "por_pagina": 20
  }
}

### Obtener productos destacados para construcción
GET {{baseUrl}}/construcc/productos/destacados?limit=10
{{commonHeaders}}
X-API-TOKEN: {{construccToken}}

### Verificar disponibilidad de productos para proyecto
POST {{baseUrl}}/construcc/productos/verificar-disponibilidad
{{commonHeaders}}
X-API-TOKEN: {{construccToken}}

{
  "productos": [
    {
      "producto_id": 1,
      "cantidad_requerida": 50,
      "fecha_requerida": "2025-09-15"
    },
    {
      "producto_id": 2,
      "cantidad_requerida": 25,
      "fecha_requerida": "2025-09-15"
    }
  ],
  "proyecto": {
    "nombre": "Construcción Plaza Comercial",
    "ubicacion": "CDMX",
    "tipo": "comercial"
  }
}

### ---- GESTIÓN DE COTIZACIONES CRUD ----

### Listar cotizaciones con filtros
GET {{baseUrl}}/construcc/cotizaciones?proveedor_id={{proveedorId}}&estado=vigentes&fecha_desde=2025-01-01&fecha_hasta=2025-12-31&per_page=20
{{commonHeaders}}
Authorization: Bearer {{construccToken}}

### Crear nueva cotización
POST {{baseUrl}}/construcc/cotizaciones
{{commonHeaders}}
Authorization: Bearer {{construccToken}}

{
  "proveedor_id": 3,
  "fecha_cotizacion": "2025-08-23",
  "fecha_vencimiento": "2025-09-23",
  "observaciones": "Cotización para proyecto residencial",
  "detalles": [
    {
      "producto_id": 40,
      "cantidad_cotizada": 100,
      "precio_unitario": 150.00,
      "tiempo_entrega_dias": 15,
      "observaciones": "Material de alta calidad"
    },
    {
      "producto_id": 43,
      "cantidad_cotizada": 50,
      "precio_unitario": 300.00,
      "tiempo_entrega_dias": 10,
      "observaciones": "Instalación incluida"
    }
  ]
}

### Ver cotización específica
GET {{baseUrl}}/construcc/cotizaciones/{{cotizacionId}}
{{commonHeaders}}
Authorization: Bearer {{construccToken}}

### Actualizar cotización existente
PATCH {{baseUrl}}/construcc/cotizaciones/{{cotizacionId}}
{{commonHeaders}}
Authorization: Bearer {{construccToken}}

{
  "fecha_vencimiento": "2025-10-23",
  "observaciones": "Cotización actualizada con nueva fecha de vencimiento",
  "detalles": [
    {
      "id": 1,
      "producto_id": {{productoId}},
      "cantidad_cotizada": 120,
      "precio_unitario": 145.00,
      "tiempo_entrega_dias": 12,
      "observaciones": "Cantidad y precio actualizados"
    },
    {
      "producto_id": 3,
      "cantidad_cotizada": 25,
      "precio_unitario": 200.00,
      "tiempo_entrega_dias": 7,
      "observaciones": "Nuevo producto agregado"
    }
  ]
}

### Eliminar cotización
DELETE {{baseUrl}}/construcc/cotizaciones/{{cotizacionId}}
{{commonHeaders}}
Authorization: Bearer {{construccToken}}

### ---- COTIZACIONES PARA PROYECTOS (COMPATIBILIDAD) ----

### Crear cotización para proyecto de construcción (formato legacy)
POST {{baseUrl}}/construcc/cotizaciones-proyecto
{{commonHeaders}}
X-API-TOKEN: {{construccToken}}

{
  "proyecto": {
    "nombre": "Edificio Residencial Torre Norte",
    "descripcion": "Construcción de edificio de 15 pisos",
    "ubicacion": "CDMX, Col. Roma Norte",
    "tipo": "residencial",
    "fecha_inicio": "2025-10-01",
    "fecha_fin": "2026-06-30"
  },
  "productos": [
    {
      "producto_id": 1,
      "cantidad": 100,
      "precio_unitario": 150.00,
      "especificaciones": "Calidad premium"
    },
    {
      "producto_id": 2,
      "cantidad": 50,
      "precio_unitario": 300.00,
      "especificaciones": "Instalación incluida"
    }
  ],
  "descuentos": {
    "por_volumen": 5.0,
    "por_cliente_frecuente": 2.0
  },
  "condiciones": {
    "forma_pago": "30-60-90 dias",
    "entrega": "Obra según cronograma",
    "garantia": "12 meses"
  }
}

### Ver cotización de proyecto específica
GET {{baseUrl}}/construcc/cotizaciones-proyecto/1
{{commonHeaders}}
X-API-TOKEN: {{construccToken}}

### Aprobar cotización de proyecto
PATCH {{baseUrl}}/construcc/cotizaciones-proyecto/1/aprobar
{{commonHeaders}}
X-API-TOKEN: {{construccToken}}

{
  "aprobado_por": "Ing. Juan Pérez",
  "fecha_aprobacion": "2025-08-25",
  "observaciones": "Cotización aprobada para inicio inmediato"
}

### Crear pedido a partir de cotización aprobada
POST {{baseUrl}}/construcc/pedidos/desde-cotizacion
{{commonHeaders}}
X-API-TOKEN: {{construccToken}}

{
  "cotizacion_id": 1,
  "programacion_entregas": [
    {
      "fecha": "2025-09-15",
      "productos": [
        {
          "producto_id": 1,
          "cantidad": 50
        }
      ]
    },
    {
      "fecha": "2025-10-15",
      "productos": [
        {
          "producto_id": 1,
          "cantidad": 50
        },
        {
          "producto_id": 2,
          "cantidad": 50
        }
      ]
    }
  ],
  "direccion_obra": {
    "calle": "Av. Insurgentes Sur 1234",
    "colonia": "Del Valle",
    "ciudad": "CDMX",
    "cp": "03100",
    "referencias": "Junto al metro Hospital 20 de Noviembre"
  }
}

### Reporte de consumo por obra
GET {{baseUrl}}/construcc/reportes/consumo-obra?obra_id=1&fecha_inicio=2025-08-01&fecha_fin=2025-08-31
{{commonHeaders}}
X-API-TOKEN: {{construccToken}}

### Buscar proveedores especializados
GET {{baseUrl}}/construcc/proveedores/especializados?especialidad=herramientas&ubicacion=cdmx&radio=50km
{{commonHeaders}}
X-API-TOKEN: {{construccToken}}

###############################################################################
# 🔄 8. RUTAS DE COMPATIBILIDAD
###############################################################################

### Listar pedidos (ruta de compatibilidad)
GET {{baseUrl}}/pedidos
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Crear pedido (ruta de compatibilidad)
POST {{baseUrl}}/pedidos
{{commonHeaders}}
Authorization: Bearer {{authToken}}

{
  "productos": [
    {
      "producto_id": 1,
      "cantidad": 2,
      "precio_unitario": 150.00
    }
  ],
  "observaciones": "Pedido de prueba"
}

### Ver pedido (ruta de compatibilidad)
GET {{baseUrl}}/pedidos/{{pedidoId}}
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Actualizar status (ruta de compatibilidad)
PATCH {{baseUrl}}/pedidos/{{pedidoId}}/status
{{commonHeaders}}
Authorization: Bearer {{authToken}}

{
  "status": "en_proceso"
}

### Cancelar pedido (ruta de compatibilidad)
PATCH {{baseUrl}}/pedidos/{{pedidoId}}/cancel
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Duplicar pedido (ruta de compatibilidad)
POST {{baseUrl}}/pedidos/{{pedidoId}}/duplicate
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Estadísticas (ruta de compatibilidad)
GET {{baseUrl}}/pedidos/estadisticas
{{commonHeaders}}
Authorization: Bearer {{authToken}}


# ===============================
# Solicitudes de Pago
# ===============================

### Listar todas las solicitudes de pago
GET {{baseUrl}}/proveedores/3/solicitudes-pago
Content-Type: application/json
Authorization: Bearer {{authToken}}

### Crear nueva solicitud de pago
POST {{baseUrl}}/proveedores/3/solicitudes-pago
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "numero_folio_solicitud": "FOLIO123",
    "descripcion_concepto": "Pago de servicios",
    "ruta_archivo_factura_xml": "/files/factura123.xml",
    "ruta_archivo_factura_pdf": "/files/factura123.pdf",
    "id_proveedor": 3,
    "id_sucursal": 6
}

### Obtener una solicitud de pago específica
GET {{baseUrl}}/proveedores/3/solicitudes-pago/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

### Actualizar estado de la solicitud
PATCH {{baseUrl}}/proveedores/3/solicitudes-pago/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "estado_solicitud": "procesando"
}

### Eliminar solicitud de pago
DELETE {{baseUrl}}/proveedores/3/solicitudes-pago/1
Authorization: Bearer {{authToken}}


# ===============================
# Cuentas Bancarias
# ===============================

### Listar cuentas bancarias
GET {{baseUrl}}/cuentas_bancarias
Content-Type: application/json
Authorization: Bearer {{authToken}}

### Crear nueva cuenta bancaria
POST {{baseUrl}}/cuentas_bancarias
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "proveedor_id": 1,
    "alias": "Cuenta Principal",
    "banco_clave": "001",
    "banco_nombre": "Banco Ejemplo",
    "tipo_cuenta": "clabe",
    "campo_dependiente": "123456789012345678",
    "titular_cuenta": "Juan Pérez",
    "referencia": "Ref123",
    "sucursal": "Sucursal Centro",
    "swift": "ABC123",
    "preferida": true,
    "moneda": "MXN"
}

### Obtener cuenta bancaria específica
GET {{baseUrl}}/cuentas_bancarias/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

### Actualizar cuenta bancaria
PATCH {{baseUrl}}/cuentas_bancarias/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "alias": "Cuenta Actualizada"
}

### Eliminar cuenta bancaria
DELETE {{baseUrl}}/cuentas_bancarias/1
Authorization: Bearer {{authToken}}

