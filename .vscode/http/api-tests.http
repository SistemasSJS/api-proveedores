###
# 🧪 API PROVEEDORES - PRUEBAS COMPLETAS
# Archivo único con todas las rutas organizadas por secciones
# Actualiza las variables según tu entorno antes de usar
###

###############################################################################
# 🔧 CONFIGURACIÓN Y VARIABLES GLOBALES
###############################################################################

@baseUrl = http://localhost:8080/api
@contentType = application/json
@acceptType = application/json

### Variables de autenticación (actualizar con tokens reales)
@authToken = 
@adminToken = 
@gerenteToken = 
@clienteToken = 
@construccToken = 1|t1GPXQQeh1K8BYfRaELBIV2ce18sqorlUKsaR9OHfba2444d

### Variables de IDs comunes (actualizar según tu base de datos)
@userId = 1
@proveedorId = 1
@productoId = 1
@pedidoId = 1
@categoriaId = 1
@marcaId = 1
@sucursalId = 1
@cotizacionId = 1

### Headers comunes
@commonHeaders = Content-Type: {{contentType}}
Accept: {{acceptType}}

###############################################################################
# 🌐 1. RUTAS PÚBLICAS (SIN AUTENTICACIÓN)
###############################################################################

### Verificar estado de la API
GET {{baseUrl}}/status
{{commonHeaders}}

### Obtener roles disponibles
GET {{baseUrl}}/roles-index
{{commonHeaders}}

### Obtener tipos de empresa
GET {{baseUrl}}/tipos-empresa-index
{{commonHeaders}}

### Obtener proveedores (público)
GET {{baseUrl}}/proveedores
{{commonHeaders}}

### Obtener sucursales (público)
GET {{baseUrl}}/sucursales
{{commonHeaders}}

### Obtener productos (público)
GET {{baseUrl}}/productos
{{commonHeaders}}

### Obtener imágenes de productos
GET {{baseUrl}}/imagenes
{{commonHeaders}}

### Obtener unidades de medida
GET {{baseUrl}}/unidades-medida
{{commonHeaders}}

### Obtener categorías
GET {{baseUrl}}/categorias
{{commonHeaders}}

### Obtener marcas
GET {{baseUrl}}/marcas
{{commonHeaders}}

### Webhook tracking update (simulación)
POST {{baseUrl}}/pedidos/1/tracking-update
{{commonHeaders}}

{
  "status": "en_transito",
  "tracking_number": "ABC123456",
  "carrier": "DHL",
  "location": "Ciudad de México",
  "estimated_delivery": "2025-08-25"
}

### Consulta pública de estado de pedido (requiere token público)
GET {{baseUrl}}/pedidos/{{pedidoId}}/status/public-token-here
{{commonHeaders}}

###############################################################################
# 🔐 2. AUTENTICACIÓN
###############################################################################

### Login - Obtener token de acceso
# @name login
POST {{baseUrl}}/auth/login
{{commonHeaders}}

{
  "email": "proveedor@elgrangero.com",
  "password": "password"
}

### Extraer token del response del login
@authToken = {{login.response.body.data.token}}

### Obtener información del usuario autenticado
GET {{baseUrl}}/auth/me
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Refresh token
POST {{baseUrl}}/auth/refresh
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Logout
GET {{baseUrl}}/auth/logout
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Registro de nuevo usuario
POST {{baseUrl}}/auth/register
{{commonHeaders}}

{
  "name": "Usuario de Prueba",
  "email": "prueba@test.com",
  "password": "password123",
  "password_confirmation": "password123",
  "role_id": 3
}

### Solicitar reset de contraseña
POST {{baseUrl}}/auth/password/email
{{commonHeaders}}

{
  "email": "usuario@test.com"
}

### Reset contraseña con token
POST {{baseUrl}}/auth/password/reset
{{commonHeaders}}

{
  "token": "reset-token-here",
  "email": "usuario@test.com",
  "password": "nueva_password",
  "password_confirmation": "nueva_password"
}

###############################################################################
# 🤝 3. RECURSOS COMPARTIDOS (TODOS LOS ROLES AUTENTICADOS)
###############################################################################

### Proveedores para filtros
GET {{baseUrl}}/tienda/proveedores
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Sucursales para filtros
GET {{baseUrl}}/tienda/sucursales
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Productos de la tienda
GET {{baseUrl}}/tienda/productos
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Accesos rápidos
GET {{baseUrl}}/tienda/accesos-rapidos
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Proveedores principales
GET {{baseUrl}}/tienda/proveedores/principales
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Productos destacados
GET {{baseUrl}}/tienda/productos/destacados
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Productos más pedidos
GET {{baseUrl}}/tienda/productos/mas-pedidos
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Productos recientes
GET {{baseUrl}}/tienda/productos/recientes
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Mostrar producto específico
GET {{baseUrl}}/tienda/productos/{{productoId}}
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Buscar productos
GET {{baseUrl}}/productos/buscar?q=producto&categoria_id={{categoriaId}}&marca_id={{marcaId}}&proveedor_id={{proveedorId}}
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Verificar disponibilidad de producto
GET {{baseUrl}}/productos/{{productoId}}/disponibilidad
{{commonHeaders}}
Authorization: Bearer {{authToken}}

### Obtener estadísticas básicas
GET {{baseUrl}}/dashboard/stats
{{commonHeaders}}
Authorization: Bearer {{authToken}}

###############################################################################
# 👤 4. RUTAS CLIENTE
###############################################################################

### Listar pedidos del cliente
GET {{baseUrl}}/cliente/pedidos
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

### Crear nuevo pedido
POST {{baseUrl}}/cliente/pedidos
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

{
  "productos": [
    {
      "producto_id": 1,
      "cantidad": 5,
      "precio_unitario": 100.50
    },
    {
      "producto_id": 2,
      "cantidad": 3,
      "precio_unitario": 250.00
    }
  ],
  "observaciones": "Pedido urgente para el viernes",
  "fecha_entrega_deseada": "2025-08-30"
}

### Ver pedido específico
GET {{baseUrl}}/cliente/pedidos/{{pedidoId}}
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

### Actualizar status del pedido
PATCH {{baseUrl}}/cliente/pedidos/{{pedidoId}}/status
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

{
  "status": "confirmado",
  "observaciones": "Pedido confirmado por el cliente"
}

### Cancelar pedido
PATCH {{baseUrl}}/cliente/pedidos/{{pedidoId}}/cancel
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

{
  "motivo_cancelacion": "Ya no se necesita el pedido"
}

### Duplicar pedido existente
POST {{baseUrl}}/cliente/pedidos/{{pedidoId}}/duplicate
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

### Confirmar recepción del pedido
PATCH {{baseUrl}}/cliente/pedidos/{{pedidoId}}/confirm-reception
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

{
  "fecha_recepcion": "2025-08-25",
  "observaciones_recepcion": "Pedido recibido en perfectas condiciones"
}

### Obtener estadísticas de pedidos
GET {{baseUrl}}/cliente/pedidos/estadisticas
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

### Exportar pedidos
POST {{baseUrl}}/cliente/pedidos/export
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

{
  "formato": "xlsx",
  "fecha_inicio": "2025-01-01",
  "fecha_fin": "2025-12-31",
  "status": ["confirmado", "entregado"]
}

### Generar PDF del pedido
GET {{baseUrl}}/cliente/pedidos/{{pedidoId}}/pdf
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

### Descargar comprobante del pedido
GET {{baseUrl}}/cliente/pedidos/{{pedidoId}}/receipt
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

### Estadísticas del dashboard cliente
GET {{baseUrl}}/cliente/dashboard/stats
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

### Resumen de gastos
GET {{baseUrl}}/cliente/dashboard/resumen-gastos
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

### Reporte de mis pedidos
GET {{baseUrl}}/cliente/reportes/mis-pedidos?fecha_inicio=2025-01-01&fecha_fin=2025-12-31
{{commonHeaders}}
Authorization: Bearer {{clienteToken}}

###############################################################################
# 👔 5. RUTAS GERENTE/PROVEEDOR
###############################################################################

### Ver todos los pedidos dirigidos al proveedor
GET {{baseUrl}}/gerente/pedidos
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

### Ver pedido específico dirigido al proveedor
GET {{baseUrl}}/gerente/pedidos/{{pedidoId}}
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

### Actualizar status de pedido (proveedor)
PATCH {{baseUrl}}/gerente/pedidos/{{pedidoId}}/status
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

{
  "status": "en_preparacion",
  "observaciones": "Iniciando preparación del pedido"
}

### Confirmar pedido
PATCH {{baseUrl}}/gerente/pedidos/{{pedidoId}}/confirm
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

{
  "fecha_confirmacion": "2025-08-23",
  "fecha_entrega_estimada": "2025-08-30",
  "observaciones": "Pedido confirmado, entrega estimada"
}

### Marcar pedido como preparado
PATCH {{baseUrl}}/gerente/pedidos/{{pedidoId}}/ready
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

{
  "observaciones": "Pedido listo para entrega"
}

### Iniciar envío del pedido
PATCH {{baseUrl}}/gerente/pedidos/{{pedidoId}}/ship
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

{
  "transportista": "DHL Express",
  "numero_guia": "DHL123456789",
  "fecha_envio": "2025-08-28",
  "observaciones_envio": "Enviado por mensajería express"
}

### Marcar como entregado
PATCH {{baseUrl}}/gerente/pedidos/{{pedidoId}}/deliver
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

{
  "fecha_entrega": "2025-08-30T14:30:00Z",
  "recibido_por": "Juan Pérez",
  "observaciones_entrega": "Entregado en perfecto estado"
}

### Rechazar pedido
PATCH {{baseUrl}}/gerente/pedidos/{{pedidoId}}/reject
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

{
  "motivo_rechazo": "Sin stock suficiente",
  "observaciones": "No contamos con inventario para completar el pedido"
}

### Actualizar información de tracking
PATCH {{baseUrl}}/gerente/pedidos/{{pedidoId}}/tracking
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

{
  "numero_guia": "DHL123456789",
  "transportista": "DHL Express",
  "ubicacion_actual": "Centro de distribución CDMX",
  "estado_tracking": "en_transito",
  "fecha_estimada_entrega": "2025-08-30"
}

### Ver productos del proveedor
GET {{baseUrl}}/gerente/productos
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

### Crear nuevo producto
POST {{baseUrl}}/gerente/productos
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

{
  "sku": "PROD-001",
  "nombre": "Producto de prueba",
  "descripcion": "Descripción del producto de prueba",
  "precio_base": 150.00,
  "precio_mayoreo": 120.00,
  "precio_menudeo": 180.00,
  "categoria_id": 1,
  "marca_id": 1,
  "unidad_medida_id": 1,
  "stock": 100,
  "activo": true
}

### Ver producto específico del proveedor
GET {{baseUrl}}/gerente/productos/{{productoId}}
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

### Actualizar producto del proveedor
PUT {{baseUrl}}/gerente/productos/{{productoId}}
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

{
  "nombre": "Producto actualizado",
  "descripcion": "Nueva descripción del producto",
  "precio_base": 160.00,
  "stock": 85,
  "activo": true
}

### Eliminar producto del proveedor
DELETE {{baseUrl}}/gerente/productos/{{productoId}}
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

### Actualizar stock del producto
PATCH {{baseUrl}}/gerente/productos/{{productoId}}/stock
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

{
  "stock": 75,
  "observaciones": "Ajuste de inventario"
}

### Estadísticas del dashboard gerente
GET {{baseUrl}}/gerente/dashboard/stats
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

### Resumen de ventas
GET {{baseUrl}}/gerente/dashboard/resumen-ventas
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

### Reporte de ventas
GET {{baseUrl}}/gerente/reportes/ventas?fecha_inicio=2025-01-01&fecha_fin=2025-12-31
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

### Ver configuración del proveedor
GET {{baseUrl}}/gerente/configuracion
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

### Actualizar configuración del proveedor
PUT {{baseUrl}}/gerente/configuracion
{{commonHeaders}}
Authorization: Bearer {{gerenteToken}}

{
  "nombre_empresa": "Mi Empresa Proveedora SA",
  "direccion": "Av. Industrial 456, Zona Industrial",
  "telefono": "555-123-4567",
  "email_contacto": "contacto@miempresa.com",
  "dias_entrega_promedio": 5,
  "horario_atencion": "Lunes a Viernes 8:00 - 17:00"
}

