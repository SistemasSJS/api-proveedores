###############################################################################
# API CONSTRUCCIÓN - GESTIÓN DE PROVEEDORES (tipo_alta = 2)
# 
# Proveedores registrados por usuarios de construcción
# Incluye: CRUD de proveedores, cuentas bancarias y solicitudes de pago
###############################################################################

@baseUrl = http://localhost:80/api
@apiKey =  7f2wnCyn7ctmTE7B3mrtDPKCPVF9z8pYseihsHA6
@proveedorId = 8
@cuentaId = 1

###############################################################################
# 1. PROVEEDORES (tipo_alta = 2)
###############################################################################

### 1.1 Listar Proveedores de Construcción
GET {{baseUrl}}/construcc/proveedor
X-API-KEY: {{apiKey}}
Content-Type: application/json

### 1.2 Listar Proveedores con Paginación y Filtros
GET {{baseUrl}}/construcc/proveedor?page=1&per_page=10&sort_by=nombre_comercial&order=asc
X-API-KEY: {{apiKey}}
Content-Type: application/json

### 1.3 Obtener Detalle de Proveedor
GET {{baseUrl}}/construcc/proveedor/{{proveedorId}}
X-API-KEY: {{apiKey}}
Content-Type: application/json

### 1.4 Crear Proveedor con Cuenta Bancaria
POST {{baseUrl}}/construcc/proveedor
X-API-KEY: {{apiKey}}
Content-Type: application/json

{
  "razon_social": "Constructora Ejemplo SA de CV",
  "nombre_comercial": "Constructora Ejemplo",
  "rfc": "CEJ850101ABC",
  "email": "contacto@constructoraejemplo.com",
  "telefono": "5512345678",
  "celular": "5598765432",
  "empresa_construcc_id": 1,
  "usuario_id": 10,
  "usuario_nombre": "Juan Pérez Residente",
  "cuenta": {
    "alias": "Cuenta Principal BBVA",
    "banco_clave": "012",
    "banco_nombre": "BBVA Bancomer",
    "tipo_cuenta": "tarjeta",
    "campo_dependiente": "012180001234567890",
    "titular_cuenta": "Constructora Ejemplo SA de CV",
    "referencia": "REF-001",
    "sucursal": "0001",
    "swift": "BCMRMXMMPYM"
  }
}

### 1.5 Actualizar Proveedor (Requiere ser Director o Creador)
PUT {{baseUrl}}/construcc/proveedor/{{proveedorId}}
X-API-KEY: {{apiKey}}
Content-Type: application/json

{
  "razon_social": "Constructora Ejemplo Actualizada SA de CV",
  "nombre_comercial": "Constructora Ejemplo Actualizada",
  "email": "nuevo@constructoraejemplo.com",
  "telefono": "5512345679",
  "celular": "5598765433",
  "usuario_id": 10,
  "nivel_id": 1
}

### 1.6 Dar de Baja Proveedor (Requiere ser Director o Creador)
DELETE {{baseUrl}}/construcc/proveedor/{{proveedorId}}
X-API-KEY: {{apiKey}}
Content-Type: application/json

{
  "usuario_id": 10,
  "nivel_id": 1,
  "motivo_baja": "Proveedor inactivo por falta de servicio"
}

###############################################################################
# 2. CUENTAS BANCARIAS
###############################################################################

### 2.1 Listar Cuentas Bancarias del Proveedor  
GET {{baseUrl}}/construcc/proveedor/{{proveedorId}}/cuentas
X-API-KEY: {{apiKey}}
Content-Type: application/json

### 2.2 Listar Cuentas con Ordenamiento
GET {{baseUrl}}/construcc/proveedor/{{proveedorId}}/cuentas?sort_by=alias&order=asc
X-API-KEY: {{apiKey}}
Content-Type: application/json

### 2.3 Obtener Detalle de Cuenta Bancaria
GET {{baseUrl}}/construcc/proveedor/{{proveedorId}}/cuentas/{{cuentaId}}
X-API-KEY: {{apiKey}}
Content-Type: application/json

### 2.4 Crear Cuenta Bancaria
POST {{baseUrl}}/construcc/proveedor/{{proveedorId}}/cuentas
X-API-KEY: {{apiKey}}
Content-Type: application/json

{
  "alias": "Cuenta HSBC Secundaria",
  "banco_clave": "021",
  "banco_nombre": "HSBC",
  "tipo_cuenta": "Cheques",
  "campo_dependiente": "021180005555555555",
  "titular_cuenta": "Constructora Ejemplo SA de CV",
  "referencia": "REF-HSBC-002",
  "sucursal": "0005",
  "swift": "BIMEMXMM"
}

### 2.5 Actualizar Cuenta Bancaria
PUT {{baseUrl}}/construcc/proveedor/{{proveedorId}}/cuentas/{{cuentaId}}
X-API-KEY: {{apiKey}}
Content-Type: application/json

{
  "alias": "Cuenta HSBC Actualizada",
  "referencia": "REF-HSBC-003",
  "sucursal": "0010"
}

### 2.6 Eliminar Cuenta Bancaria
DELETE {{baseUrl}}/construcc/proveedor/{{proveedorId}}/cuentas/{{cuentaId}}
X-API-KEY: {{apiKey}}
Content-Type: application/json

### 2.7 Marcar Cuenta como Favorita
POST {{baseUrl}}/construcc/proveedor/{{proveedorId}}/cuentas/{{cuentaId}}/set-favorita
X-API-KEY: {{apiKey}}
Content-Type: application/json

###############################################################################
# 3. SOLICITUDES DE PAGO (Con Proveedor Existente)
###############################################################################

### 3.1 Generar SPP con Proveedor Existente - Usuario Residente (nivel_id = 6)
# Estado: verificada = true, estado = pendiente
POST {{baseUrl}}/construcc/proveedor/{{proveedorId}}/solicitudes-pago
X-API-KEY: {{apiKey}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="descripcion_concepto"

Pago de materiales de construcción - Proyecto Torre A
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="monto_total"

25000.50
------WebKitFormBoundary7MA4YWxkTrZu0gW
