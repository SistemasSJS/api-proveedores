###
# RUTAS ESPECÍFICAS PARA ROL: ADMINISTRADOR
# Estas rutas solo son accesibles para usuarios con rol ADMINISTRADOR
###
###
# CONFIGURACIÓN GLOBAL PARA PRUEBAS API
# Variables y configuración común para todos los endpoints
###

@baseUrl = http://localhost:8000/api
@contentType = application/json
@acceptType = application/json

### Variables de autenticación (actualizar con tokens reales)
@authToken = 
@adminToken = 
@gerenteToken = 
@clienteToken = 

### Variables de IDs comunes (actualizar según tu base de datos)
@userId = 1
@proveedorId = 1
@productoId = 1
@pedidoId = 1
@categoriaId = 1
@marcaId = 1
@sucursalId = 1

### Headers comunes
@commonHeaders = Content-Type: {{contentType}}
Accept: {{acceptType}}



###
# GESTIÓN GENERAL DE USUARIOS
###
### Listar todos los usuarios
GET {{baseUrl}}/admin/usuarios
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Crear nuevo usuario
POST {{baseUrl}}/admin/usuarios
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

{
  "name": "Nuevo Usuario Admin",
  "email": "nuevo@admin.com",
  "password": "password123",
  "role_id": 1,
  "status": "activo"
}

### Ver usuario específico
GET {{baseUrl}}/admin/usuarios/{{userId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Actualizar usuario
PUT {{baseUrl}}/admin/usuarios/{{userId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

{
  "name": "Usuario Actualizado",
  "email": "actualizado@admin.com",
  "role_id": 2,
  "status": "activo"
}

### Eliminar usuario
DELETE {{baseUrl}}/admin/usuarios/{{userId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

###
# GESTIÓN DE CATÁLOGOS MAESTROS
###

### ---- PROVEEDORES ----

### Listar proveedores
GET {{baseUrl}}/admin/catalogos/proveedores
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Crear proveedor
POST {{baseUrl}}/admin/catalogos/proveedores
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

{
  "nombre": "Nuevo Proveedor SA",
  "rfc": "NPR123456789",
  "razon_social": "Nuevo Proveedor SA de CV",
  "direccion": "Av. Comercial 123",
  "telefono": "555-123-4567",
  "email": "contacto@nuevoproveedor.com",
  "activo": true
}

### Ver proveedor específico
GET {{baseUrl}}/admin/catalogos/proveedores/{{proveedorId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Actualizar proveedor
PUT {{baseUrl}}/admin/catalogos/proveedores/{{proveedorId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

{
  "nombre": "Proveedor Actualizado SA",
  "telefono": "555-987-6543",
  "activo": true
}

### Eliminar proveedor
DELETE {{baseUrl}}/admin/catalogos/proveedores/{{proveedorId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Ver productos del proveedor
GET {{baseUrl}}/admin/catalogos/proveedores/{{proveedorId}}/productos
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### ---- SUCURSALES ----

### Listar sucursales
GET {{baseUrl}}/admin/catalogos/sucursales
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Crear sucursal
POST {{baseUrl}}/admin/catalogos/sucursales
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

{
  "nombre": "Sucursal Norte",
  "proveedor_id": {{proveedorId}},
  "direccion": "Av. Norte 456",
  "telefono": "555-111-2222",
  "email": "norte@proveedor.com",
  "activo": true
}

### Ver sucursales agrupadas por proveedor
GET {{baseUrl}}/admin/catalogos/sucursales/groupedByProveedor
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Ver sucursal específica
GET {{baseUrl}}/admin/catalogos/sucursales/{{sucursalId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Actualizar sucursal
PATCH {{baseUrl}}/admin/catalogos/sucursales/{{sucursalId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

{
  "nombre": "Sucursal Norte Actualizada",
  "telefono": "555-333-4444"
}

### Eliminar sucursal
DELETE {{baseUrl}}/admin/catalogos/sucursales/{{sucursalId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### ---- PRODUCTOS ----

### Listar productos
GET {{baseUrl}}/admin/catalogos/productos
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Crear producto
POST {{baseUrl}}/admin/catalogos/productos
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

{
  "sku": "ADMIN-001",
  "nombre": "Producto Admin",
  "descripcion": "Producto creado por admin",
  "precio_base": 200.00,
  "precio_mayoreo": 180.00,
  "precio_menudeo": 220.00,
  "proveedor_id": {{proveedorId}},
  "categoria_id": {{categoriaId}},
  "marca_id": {{marcaId}},
  "stock": 50,
  "activo": true
}

### Ver producto específico
GET {{baseUrl}}/admin/catalogos/productos/{{productoId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Actualizar producto
PUT {{baseUrl}}/admin/catalogos/productos/{{productoId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

{
  "nombre": "Producto Admin Actualizado",
  "precio_base": 210.00,
  "stock": 45
}

### Eliminar producto
DELETE {{baseUrl}}/admin/catalogos/productos/{{productoId}}
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### ---- IMÁGENES ----

### Listar imágenes
GET {{baseUrl}}/admin/catalogos/imagenes
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Crear imagen
POST {{baseUrl}}/admin/catalogos/imagenes
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

{
  "producto_id": {{productoId}},
  "url": "https://example.com/imagen.jpg",
  "nombre": "Imagen principal",
  "es_principal": true,
  "activo": true
}

### Ver imagen específica
GET {{baseUrl}}/admin/catalogos/imagenes/1
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

### Actualizar imagen
PATCH {{baseUrl}}/admin/catalogos/imagenes/1
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

{
  "nombre": "Imagen actualizada",
  "es_principal": false
}

### Eliminar imagen
DELETE {{baseUrl}}/admin/catalogos/imagenes/1
{{commonHeaders}}
Authorization: Bearer {{adminToken}}

